# Python/Jupyter run on your host; Kafka runs in Docker.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# For a separate secured cluster, configure these without committing credentials:
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
# KAFKA_SSL_CA_LOCATION=/path/to/ca.pem
# KAFKA_SSL_CERTIFICATE_LOCATION=/path/to/client.pem
# KAFKA_SSL_KEY_LOCATION=/path/to/client.key

